# Copy this file to .env and replace every placeholder. Never commit .env.

# Django / database
SECRET_KEY=replace_with_a_new_random_secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-project.vercel.app
SECURE_SSL_REDIRECT=True
# Use your local PostgreSQL URL in development or the Neon URL in production.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ==============================================================================
# Email
# ==============================================================================

# OPTION 1: Gmail (Recommended & Free)
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com).
# 2. Go to "Security" -> "2-Step Verification" -> Scroll down to "App Passwords".
# 3. Create an App Password (Name: "FormCraft") -> Copy the generated 16-letter password.
# 4. Fill in below:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=FormCraft <your_email@gmail.com>

# ------------------------------------------------------------------------------
# OPTION 2: Brevo / Sendinblue (Free 300 emails/day)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_brevo_login
# EMAIL_HOST_PASSWORD=your_brevo_smtp_key
# DEFAULT_FROM_EMAIL=FormCraft <noreply@yourdomain.com>

# ------------------------------------------------------------------------------
# OPTION 3: Outlook / Office 365
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@outlook.com
# EMAIL_HOST_PASSWORD=your_password
# DEFAULT_FROM_EMAIL=FormCraft <your_email@outlook.com>
